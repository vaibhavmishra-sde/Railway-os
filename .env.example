# ============================================================
# RailwayOS — Environment Variables Template
# ============================================================
#
# PURPOSE: This file shows every environment variable the
# project uses. It contains FAKE placeholder values only.
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to Git
#
# WHY THIS FILE IS SAFE TO COMMIT:
#   It has no real secrets. It only shows the structure.
#   Developers cloning the repo know what values to fill in.
#
# ============================================================


# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
APP_NAME=RailwayOS
APP_VERSION=0.1.0
APP_ENV=development           # development | staging | production
DEBUG=true                    # Never set true in production
APP_PORT=8000

# ─────────────────────────────────────────
# SECURITY — JWT
# ─────────────────────────────────────────
# Generate a real secret with: openssl rand -hex 32
# Or in Python: import secrets; print(secrets.token_hex(32))
JWT_SECRET_KEY=your-super-secret-jwt-key-replace-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────
# DATABASE — PostgreSQL
# ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=railwayos_db
POSTGRES_USER=railwayos_user
POSTGRES_PASSWORD=your-strong-database-password

# Full DSN (Data Source Name) used by SQLAlchemy
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://railwayos_user:your-strong-database-password@localhost:5432/railwayos_db

# ─────────────────────────────────────────
# CACHE — Redis
# ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password       # Leave empty if no auth
REDIS_DB=0                               # Redis database index (0-15)
REDIS_URL=redis://:your-redis-password@localhost:6379/0

# ─────────────────────────────────────────
# AI / LLM — Railway Assistant (Phase 15)
# ─────────────────────────────────────────
# Replace with your actual provider (OpenAI, Gemini, etc.)
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gemini-pro                     # or gpt-4, claude-3, etc.
LLM_MAX_TOKENS=1024

# ─────────────────────────────────────────
# EMAIL — Notifications (Phase 12)
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@railwayos.com

# ─────────────────────────────────────────
# CORS — Frontend URL
# ─────────────────────────────────────────
# Tells the backend which frontend origin to accept
FRONTEND_URL=http://localhost:5173       # Vite dev server default

# ─────────────────────────────────────────
# RATE LIMITING (Phase 20)
# ─────────────────────────────────────────
RATE_LIMIT_REQUESTS=100                  # requests per window
RATE_LIMIT_WINDOW_SECONDS=60             # window size in seconds

# ─────────────────────────────────────────
# FIRST ADMIN USER — Seed Data Setup
# ─────────────────────────────────────────
# Used only during initial database seeding
ADMIN_EMAIL=admin@railwayos.com
ADMIN_PASSWORD=ChangeThisImmediately123!
